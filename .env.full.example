EVPOLY_MM_DUST_SELL_MAX_NOTIONAL_USD=20
EVPOLY_MM_DUST_SELL_MAX_ORDERS=20
EVPOLY_MM_DUST_SELL_MAX_SHARES=250
EVPOLY_MM_DUST_SELL_SCAN_LIMIT=4000

