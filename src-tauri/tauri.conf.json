{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EVPoly",
  "version": "0.1.6",
  "identifier": "com.evpoly.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EVPoly",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/evpoly-bot"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3QjNCQUQ0Q0UzQTcwNTgKUldSWWNEck8xTHF6bDhVMmhSTXRNOTRTTEZUbWdKbmg4QjJBb1dia1RnTUN1R3hmVC9wSzlPNHMK",
      "endpoints": [
        "https://github.com/Degenapetrader/EVPOLY/releases/latest/download/latest.json"
      ]
    }
  }
}
