+fn mm_sport_merge_market_cache(
+    existing: &[MmSportMarket],
+    updates: Vec<MmSportMarket>,
+    max_markets: usize,
+) -> Vec<MmSportMarket> {
+    let mut markets_by_condition: std::collections::HashMap<String, MmSportMarket> =
+        std::collections::HashMap::new();
+    for market in existing.iter().cloned().chain(updates.into_iter()) {
+        let condition_key = market.condition_id.trim().to_ascii_lowercase();
+        if condition_key.is_empty() {
+            continue;
+        }
+        match markets_by_condition.get_mut(condition_key.as_str()) {
+            Some(existing_market) => {
+                if market.reward_rate_per_day > existing_market.reward_rate_per_day {
+                    *existing_market = market;
+                }
+            }
+            None => {
+                markets_by_condition.insert(condition_key, market);
+            }
+        }
+    }
+    let mut markets = markets_by_condition.into_values().collect::<Vec<_>>();
+    markets.sort_by(|a, b| {
+        b.reward_rate_per_day
+            .total_cmp(&a.reward_rate_per_day)
+            .then_with(|| a.market_slug.cmp(&b.market_slug))
+    });
+    if max_markets > 0 && markets.len() > max_markets {
+        markets.truncate(max_markets);
+    }
+    markets
+}
