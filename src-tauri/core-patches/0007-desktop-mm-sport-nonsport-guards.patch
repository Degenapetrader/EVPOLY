+                entry.condition_id.trim().to_ascii_lowercase()
+            } else {
+                entry.market_slug.trim().to_ascii_lowercase()
+            };
+            if key.is_empty() || !seen.insert(key) {
+                continue;
+            }
+            out.push(entry);
+        }
+        Ok(out)
+    }
