# EVPOLY runtime env template
# Copy to .env and fill values.

# Public API endpoints (safe defaults)
POLY_GAMMA_API_URL=https://gamma-api.polymarket.com
POLY_CLOB_API_URL=https://clob.polymarket.com
POLY_POLYGON_RPC_HTTP_URL=https://1rpc.io/matic
POLY_POLYGON_RPC_HTTP_FALLBACK_URL=https://polygon-rpc.com

POLY_PRIVATE_KEY=

# Wallet mode
# 1 = Proxy wallet (email signup): no gas fee paid by user (relayer/gasless)
# 2 = Safe wallet (web3 wallet signup like MetaMask/Rabby): no gas fee paid by user (relayer/gasless)
# 0 = EOA wallet: user pays gas fee directly
POLY_SIGNATURE_TYPE=1
POLY_PROXY_WALLET_ADDRESS=

# Market selection
POLY_ENABLE_ETH_TRADING=true
POLY_ENABLE_SOLANA_TRADING=true
POLY_ENABLE_XRP_TRADING=true

# Remote builder signer (required on poly-remote)
# Signer defaults can be overridden if needed.
EVPOLY_ORDER_SIGNER_PRIMARY_URL=https://signer.evplus.ai/sign/order
EVPOLY_ORDER_SIGNER_PRIMARY_TOKEN=
EVPOLY_ORDER_SIGNER_FALLBACK_URL=
EVPOLY_SUBMIT_SIGNER_URL=
EVPOLY_BUILDER_REMOTE_SIGNER_TOKEN=
# Relayer API key path for redeem/merge submits (primary path; remote signer is fallback).
# Get these from Polymarket Settings > API Keys:
# https://polymarket.com/settings?tab=api-keys
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
# Local admin API token (recommended).
# `scripts/remote_onboard.py --write-env-file .env` auto-generates this if missing.
EVPOLY_ADMIN_API_TOKEN=
# Intentionally omitted on poly-remote: POLY_BUILDER_API_KEY / SECRET / PASSPHRASE

# Optional VPS-hosted market discovery (premarket/endgame/shared timeframe paths)
# If host is `alpha.evplus.ai`, runtime auto-retries once on `alpha2.evplus.ai`
# for timeout/429/5xx transport failures.
EVPOLY_REMOTE_MARKET_DISCOVERY_URL=https://alpha.evplus.ai/v1/discovery/timeframe
EVPOLY_REMOTE_MARKET_DISCOVERY_TOKEN=

# VPS-hosted Premarket alpha ladder (shared token + proxy wallet)
EVPOLY_REMOTE_PREMARKET_ALPHA_URL=https://alpha.evplus.ai/v1/alpha/premarket/ladder
EVPOLY_REMOTE_PREMARKET_ALPHA_TOKEN=

# VPS-hosted Endgame alpha policy (shared token + proxy wallet; fail-closed)
EVPOLY_REMOTE_ENDGAME_ALPHA_URL=https://alpha.evplus.ai/v1/alpha/endgame/policy
EVPOLY_REMOTE_ENDGAME_ALPHA_TOKEN=
EVPOLY_ENDGAME_ALPHA_REQUIRED=true

# VPS-hosted EVCurve alpha
EVPOLY_REMOTE_EVCURVE_ALPHA_URL=https://alpha.evplus.ai/v1/alpha/evcurve
EVPOLY_REMOTE_EVCURVE_ALPHA_TOKEN=

# VPS-hosted S-Band alpha
EVPOLY_REMOTE_SESSIONBAND_ALPHA_URL=https://alpha.evplus.ai/v1/alpha/sessionband
EVPOLY_REMOTE_SESSIONBAND_ALPHA_TOKEN=

# Optional VPS-hosted EVSnipe market-spec discovery (remote-first, local fallback on failure)
EVPOLY_REMOTE_EVSNIPE_DISCOVERY_URL=https://alpha.evplus.ai/v1/discovery/evsnipe
EVPOLY_REMOTE_EVSNIPE_DISCOVERY_TOKEN=
EVPOLY_REMOTE_EVSNIPE_DISCOVERY_TIMEOUT_MS=900

# Strategy toggles (default runtime profile)
EVPOLY_STRATEGY_PREMARKET_ENABLE=true
EVPOLY_STRATEGY_ENDGAME_ENABLE=true
EVPOLY_STRATEGY_EVCURVE_ENABLE=true
EVPOLY_STRATEGY_SESSIONBAND_ENABLE=true
EVPOLY_STRATEGY_EVSNIPE_ENABLE=true
EVPOLY_STRATEGY_MM_REWARDS_ENABLE=false
EVPOLY_STRATEGY_MM_SPORT_ENABLE=false
EVPOLY_ENDGAME_SYMBOLS=BTC,ETH,SOL,XRP,DOGE,BNB,HYPE

# Optional MM Sport strategy (top-of-book two-outcome BUY quoting on pregame sports reward markets)
EVPOLY_MM_SPORT_EVENT_DRIVEN_ENABLE=true
EVPOLY_MM_SPORT_WS_STALE_MS=600
EVPOLY_MM_SPORT_MIN_REWARD_RATE_PER_DAY=300
EVPOLY_MM_SPORT_DISCOVERY_ROUTE=sports
EVPOLY_MM_SPORT_QUOTE_SIZE_MODE=multiple
EVPOLY_MM_SPORT_QUOTE_SIZE_MULT=1.2
EVPOLY_MM_SPORT_MULTIPLE_COLLATERAL_CAP_MULT=0.45
EVPOLY_MM_SPORT_DEPTH_RATIO_COLLATERAL_CAP_MULT=0.90
EVPOLY_MM_SPORT_MAX_SHARE_RATIO=0.05
EVPOLY_MM_SPORT_MIN_TOP_DEPTH_USD=1100
EVPOLY_MM_SPORT_INVENTORY_EXIT_START_SEC=28800
EVPOLY_MM_SPORT_PAUSE_AFTER_FILL_SEC=7200
EVPOLY_MM_SPORT_ALLOWED_SPORT_LEAGUE_CODES=
EVPOLY_MM_SPORT_BLOCKED_SPORT_LEAGUE_CODES=
EVPOLY_MM_SPORT_BLOCKED_COMPETITION_LEVELS=
EVPOLY_MM_SPORT_MARKET_ALLOWLIST_KEYWORDS=
EVPOLY_MM_SPORT_MARKET_BLACKLIST_KEYWORDS=
EVPOLY_MM_SPORT_REWARD_MIN_SHARES_CAP=0
EVPOLY_MM_SPORT_MATCH_ONLY=false
EVPOLY_MM_SPORT_POLYMARKET_LIVE_GUARD_ENABLE=true
EVPOLY_MM_SPORT_POLYMARKET_LIVE_GUARD_WS_ENABLE=true
EVPOLY_MM_SPORT_POLYMARKET_LIVE_GUARD_WS_STALE_MS=600000
EVPOLY_REMOTE_MM_SPORT_DEPTH_SKIP_ALPHA_URL=https://alpha.evplus.ai/v1/alpha/mm-sport/depth-skip
EVPOLY_REMOTE_MM_SPORT_DEPTH_SKIP_ALPHA_TOKEN=
EVPOLY_REMOTE_MM_SPORT_ALPHA_TIMEOUT_MS=8000
EVPOLY_MM_HARD_DISABLE=false
EVPOLY_MM_MODE=live

# Unified strategy base sizing (desktop defaults)
EVPOLY_WEEKEND_POLICY=off
EVPOLY_PREMARKET_BASE_SIZE_USD=10
EVPOLY_PREMARKET_TIMEFRAMES=5m,15m,1h,4h
EVPOLY_SYMBOL_SIZE_MULTIPLIER_BTC=1.0
EVPOLY_SYMBOL_SIZE_MULTIPLIER_ETH=0.8
EVPOLY_SYMBOL_SIZE_MULTIPLIER_SOL=0.5
EVPOLY_SYMBOL_SIZE_MULTIPLIER_XRP=0.5
EVPOLY_SYMBOL_SIZE_MULTIPLIER_DOGE=0.5
EVPOLY_SYMBOL_SIZE_MULTIPLIER_BNB=0.5
EVPOLY_SYMBOL_SIZE_MULTIPLIER_HYPE=0.5
EVPOLY_PREMARKET_TIMEFRAME_MULTIPLIER_5M=0.75
EVPOLY_PREMARKET_TIMEFRAME_MULTIPLIER_15M=1.0
EVPOLY_PREMARKET_TIMEFRAME_MULTIPLIER_1H=1.25
EVPOLY_PREMARKET_TIMEFRAME_MULTIPLIER_4H=1.25
EVPOLY_PREMARKET_TIMEFRAME_MULTIPLIER_1D=1.25
EVPOLY_PREMARKET_LADDER_MODE_5M=normal
EVPOLY_PREMARKET_LADDER_MODE_NON_5M=normal
EVPOLY_PREMARKET_TP_ENABLE=true
EVPOLY_PREMARKET_ACTIVE_CAP_PER_ASSET=100
EVPOLY_PREMARKET_CANCEL_AFTER_OPEN_5M_SEC=20
EVPOLY_PREMARKET_CANCEL_AFTER_OPEN_15M_SEC=15
EVPOLY_PREMARKET_CANCEL_AFTER_OPEN_1H_SEC=60
EVPOLY_PREMARKET_CANCEL_AFTER_OPEN_4H_SEC=180
EVPOLY_ENDGAME_BASE_SIZE_USD=50
EVPOLY_ENDGAME_TIMEFRAMES=5m,15m,1h,4h
EVPOLY_ENDGAME_PER_PERIOD_CAP_USD=10000
EVPOLY_ENDGAME_TICK0_MULTIPLIER=0.20
EVPOLY_ENDGAME_TICK1_MULTIPLIER=0.40
EVPOLY_ENDGAME_TICK2_MULTIPLIER=0.40
EVPOLY_EVCURVE_BASE_SIZE_USD=10
EVPOLY_EVCURVE_TIMEFRAME_MULTIPLIER_15M=0.75
EVPOLY_EVCURVE_TIMEFRAME_MULTIPLIER_1H=1.0
EVPOLY_EVCURVE_TIMEFRAME_MULTIPLIER_4H=1.25
EVPOLY_EVCURVE_TIMEFRAME_MULTIPLIER_1D=1.25
EVPOLY_EVCURVE_TIMEFRAMES=15m,1h,4h,1d
EVPOLY_EVCURVE_MAX_FLIP_PROB=0.15
EVPOLY_EVCURVE_MIN_BUY_PRICE=0.60
EVPOLY_EVCURVE_D1_ENABLE=true
EVPOLY_EVCURVE_D1_STRATEGY_CAP_USD=10000
EVPOLY_EVCURVE_FILL_FALLBACK_POLL_MS=1500
EVPOLY_SESSIONBAND_BASE_SIZE_USD=10
EVPOLY_SESSIONBAND_TIMEFRAMES=5m,15m,1h,4h
EVPOLY_SESSIONBAND_FLIP_THRESHOLD_PCT=2
EVPOLY_SESSIONBAND_ALLOWED_TAU_SEC=2,1
EVPOLY_SESSIONBAND_TAU2_MULTIPLIER=0.30
EVPOLY_SESSIONBAND_TAU1_MULTIPLIER=0.70
EVPOLY_EVSNIPE_SIZE_USD=10
EVPOLY_EVSNIPE_PRE_TRIGGER_BPS=1
EVPOLY_EVSNIPE_STRIKE_WINDOW_PCT=0.10
EVPOLY_EVSNIPE_MAX_DAYS_TO_EXPIRY=30
EVPOLY_EVSNIPE_PRE_LEG_RATIO=0.30
EVPOLY_MM_SINGLE_MARKET_SLUGS=
EVPOLY_MM_AUTO_TOP_N=80
EVPOLY_MM_AUTO_REFRESH_SEC=900
EVPOLY_MM_AUTO_RANK_BUDGET_USD=2000
EVPOLY_MM_MARKET_BLACKLIST_KEYWORDS=
EVPOLY_MM_REWARD_MIN_SHARES_CAP=0
EVPOLY_MM_NEAR_EXPIRY_EXIT_WINDOW_SEC=86400
EVPOLY_MM_SPORT_EXIT_MODE=normal
EVPOLY_MM_SPORT_QUOTE_EXPIRY_MIN_SEC=180
EVPOLY_MM_SPORT_QUOTE_EXPIRY_MAX_SEC=300

# Retention (keeps runtime artifacts bounded; set cron via scripts/install_evpoly_retention_cron.sh)
EVPOLY_EVENTS_ROTATE_KEEP=3
EVPOLY_HISTORY_ROTATE_KEEP=3
EVPOLY_DB_BACKUP_RETENTION_DAYS=3
EVPOLY_HISTORY_DIR_RETENTION_DAYS=3
EVPOLY_RETENTION_CRON_EXPR="17 * * * *"

# Startup controls
# Keep core defaults, but disable startup-wide cancel-all on desktop and
# move that cleanup to user-initiated stop/quit instead.
EVPOLY_STARTUP_PENDING_RECONCILE_ENABLE=false
EVPOLY_STARTUP_CANCEL_ALL_ORDERS=false
EVPOLY_STARTUP_CANCEL_ALL_SKIP_IF_MM_REWARDS=true
