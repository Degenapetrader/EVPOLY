# EVPOLY runtime env template
# Copy to .env and fill values.

# Public API endpoints (safe defaults)
POLY_GAMMA_API_URL=https://gamma-api.polymarket.com
POLY_CLOB_API_URL=https://clob.polymarket.com
POLY_POLYGON_RPC_HTTP_URL=https://1rpc.io/matic
POLY_POLYGON_RPC_HTTP_FALLBACK_URL=https://polygon-rpc.com

POLY_PRIVATE_KEY=

# Wallet mode
# 1 = Proxy wallet (email signup): no gas fee paid by user (relayer/gasless)
# 2 = Safe wallet (web3 wallet signup like MetaMask/Rabby): no gas fee paid by user (relayer/gasless)
# 3 = Deposit wallet (POLY_1271): pUSD must be held by the deposit wallet
# 0 = EOA wallet: user pays gas fee directly
POLY_SIGNATURE_TYPE=1
POLY_PROXY_WALLET_ADDRESS=
POLY_DEPOSIT_WALLET_ADDRESS=
POLY_FUNDER_WALLET_ADDRESS=

# CLOB V2 builder attribution is built in for the official EVPOLY runtime.
# Advanced only: POLY_BUILDER_CODE can override it, but EVPOLY alpha access requires the official code.
# Builder fees apply to all trades: 0.1% on both taker and maker fills.
# Builder maker/taker fee rates are not local env settings.
# Polymarket applies the active server-side builder fee rates at match time.
# POLY_BUILDER_CODE=

# Self-serve alpha access. Blank => runtime auto-registers with the alpha server on first start.
EVPOLY_ALPHA_AUTO_ONBOARD=true
EVPOLY_ALPHA_KEY=

# Relayer submit signer values are used only for non-order proxy wallet flows
# such as redeem, merge, approvals, and Auto-Redeem approval toggles.
# Normal CLOB V2 order posting uses local SDK signing plus POLY_BUILDER_CODE when configured.
# Orders do not include local feeRateBps or local builder fee bps.
EVPOLY_RELAYER_SUBMIT_SIGNER_URL=
EVPOLY_RELAYER_REMOTE_SIGNER_TOKEN=
# Relayer API key path for redeem/merge/approval submits (primary path; remote signer is fallback).
# Get these from Polymarket Settings > API Keys:
# https://polymarket.com/settings?tab=api-keys
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
# Local admin API token (recommended).
# `scripts/remote_onboard.py --write-env-file .env` auto-generates this if missing.
EVPOLY_ADMIN_API_TOKEN=
# Optional separate manual API token. If blank, manual_bot uses EVPOLY_ADMIN_API_TOKEN.
EVPOLY_MANUAL_BOT_TOKEN=
# Local unauthenticated manual_bot is disabled by default. Enable only for disposable local development.
EVPOLY_MANUAL_BOT_ALLOW_UNAUTH_LOCAL=false
# Auto-Redeem approval uses the manual API and does not require a separate env key.

# Optional VPS-hosted market discovery (premarket/endgame/shared timeframe paths)
# If host is `alpha.evplus.ai`, runtime auto-retries once on `alpha2.evplus.ai`
# for timeout/429/5xx transport failures.
EVPOLY_REMOTE_MARKET_DISCOVERY_URL=https://alpha.evplus.ai/v1/discovery/timeframe
# Blank => uses EVPOLY_ALPHA_KEY.
EVPOLY_REMOTE_MARKET_DISCOVERY_TOKEN=
# Remote alpha and relayer-signer URLs must be HTTPS by default.
# Enable only for localhost/dev HTTP endpoints.
EVPOLY_ALLOW_INSECURE_REMOTE_URLS=false

# VPS-hosted Premarket alpha ladder (shared token + proxy wallet)
EVPOLY_REMOTE_PREMARKET_ALPHA_URL=https://alpha.evplus.ai/v1/alpha/premarket/ladder
# Blank => uses EVPOLY_ALPHA_KEY.
EVPOLY_REMOTE_PREMARKET_ALPHA_TOKEN=

# Endgame V1 uses local checkpoint policy plus background market/quote prewarm.
EVPOLY_ENDGAME_FAST_SUBMIT_ENABLE=true
EVPOLY_ENDGAME_PM_QUOTE_CACHE_ENABLE=true
EVPOLY_ENDGAME_QUOTE_MAX_AGE_MS=500
EVPOLY_ENDGAME_QUOTE_MAX_ASK_LEVELS=20
EVPOLY_ENDGAME_DECISION_MAX_AGE_MS=300
EVPOLY_ENDGAME_REGISTRY_WORKER_ENABLE=true
EVPOLY_ENDGAME_REGISTRY_POLL_MS=250
EVPOLY_ENDGAME_REGISTRY_PREWARM_MS=90000
EVPOLY_ENDGAME_FEE_PREWARM_ENABLE=true
EVPOLY_ENDGAME_SUBMIT_COLLATERAL_PREWARM_ENABLE=true
EVPOLY_ENDGAME_SUBMIT_COLLATERAL_PREWARM_INTERVAL_MS=5000
EVPOLY_ENDGAME_SUBMIT_LANE_ENABLE=true
EVPOLY_ENDGAME_SUBMIT_LANE_PERMITS=1
EVPOLY_ENDGAME_SUBMIT_TIMEOUT_MS=1500
EVPOLY_ENDGAME_SUBMIT_OUTCOME_WAIT_MS=2500
EVPOLY_ENDGAME_REST_BATCH_POLL_ENABLE=true
EVPOLY_ENDGAME_REST_BATCH_POLL_MS=100
EVPOLY_ENDGAME_REST_BATCH_TIMEOUT_MS=500
EVPOLY_ENDGAME_REST_BATCH_MAX_TOKENS=24
EVPOLY_ENDGAME_QUOTE_RESCUE_ENABLE=true
EVPOLY_ENDGAME_QUOTE_RESCUE_TIMEOUT_MS=120
EVPOLY_ENDGAME_QUOTE_RESCUE_FINAL_GUARD_MS=250
EVPOLY_ENDGAME_CEX_DEPTH_GUARD_ENABLE=true
EVPOLY_ENDGAME_CEX_DEPTH_POLL_ENABLE=true
EVPOLY_ENDGAME_CEX_DEPTH_ADAPTIVE_POLL_ENABLE=true
EVPOLY_ENDGAME_CEX_DEPTH_SAMPLE_MS=250
EVPOLY_ENDGAME_CEX_DEPTH_COINBASE_SAMPLE_MS=250
EVPOLY_ENDGAME_CEX_DEPTH_BINANCE_SAMPLE_MS=1000
EVPOLY_ENDGAME_CEX_DEPTH_WARM_SAMPLE_MS=1000
EVPOLY_ENDGAME_CEX_DEPTH_COLD_SAMPLE_MS=5000
EVPOLY_ENDGAME_CEX_DEPTH_MAX_AGE_MS=2000
EVPOLY_ENDGAME_CEX_DEPTH_HISTORY_KEEP_MS=14400000
EVPOLY_ENDGAME_CEX_DEPTH_HISTORY_SAMPLE_MS=5000
EVPOLY_ENDGAME_CEX_DEPTH_MIN_SAMPLES=300
EVPOLY_ENDGAME_CEX_DEPTH_REDUCE_QUANTILE=0.03
EVPOLY_ENDGAME_CEX_DEPTH_CLOSE_REDUCE_QUANTILE=0.05
EVPOLY_ENDGAME_CEX_DEPTH_WARM_REDUCE_QUANTILE=0.04
EVPOLY_ENDGAME_CEX_DEPTH_DELTA_ENABLE=true
EVPOLY_ENDGAME_CEX_DEPTH_PERSIST_ENABLE=true
EVPOLY_ENDGAME_NEAR_BASE_SKIP_BPS=1.5

# VPS-hosted EVcurve alpha decision (Plan3/PlanDaily curve logic; fail-closed)
EVPOLY_REMOTE_EVCURVE_ALPHA_URL=https://alpha.evplus.ai/v1/alpha/evcurve
# Blank => uses EVPOLY_ALPHA_KEY.
EVPOLY_REMOTE_EVCURVE_ALPHA_TOKEN=

# VPS-hosted SessionBand alpha decision (Plan4B band logic; fail-closed)
EVPOLY_REMOTE_SESSIONBAND_ALPHA_URL=https://alpha.evplus.ai/v1/alpha/sessionband
# Blank => uses EVPOLY_ALPHA_KEY.
EVPOLY_REMOTE_SESSIONBAND_ALPHA_TOKEN=

# Strategy toggles (default runtime profile)
EVPOLY_STRATEGY_PREMARKET_ENABLE=true
EVPOLY_STRATEGY_ENDGAME_ENABLE=true
EVPOLY_STRATEGY_EVCURVE_ENABLE=true
EVPOLY_STRATEGY_EVSNIPE_ENABLE=true
EVPOLY_STRATEGY_MM_SPORT_ENABLE=false
EVPOLY_ENDGAME_SYMBOLS=BTC,ETH,SOL,XRP,DOGE,BNB,HYPE
# Required for local millisecond checkpoints such as t-100ms.
EVPOLY_ENDGAME_SAFETY_STOP_SEC=0
EVPOLY_EVCURVE_SYMBOLS=BTC,ETH,SOL,XRP
EVPOLY_SESSIONBAND_SYMBOLS=BTC,ETH,SOL,XRP
EVPOLY_EVSNIPE_SYMBOLS=BTC,ETH,SOL,XRP,DOGE,BNB,HYPE
EVPOLY_PM_WS_REFRESH_SEC=90
EVPOLY_PM_WS_MARKET_DISCOVERY_LIMIT=250
EVPOLY_PM_WS_STICKY_SCOPE_TTL_MS=900000
EVPOLY_PM_WS_STICKY_SCOPE_MAX_MARKETS=300
EVPOLY_PM_WS_STICKY_SCOPE_MAX_ASSETS=650
EVPOLY_TRACE_ENTRY_EXECUTION_TIMING=false
EVPOLY_HTTP_POOL_MAX_IDLE_PER_HOST=6
EVPOLY_HTTP_POOL_IDLE_TIMEOUT_SEC=8
EVPOLY_HTTP_READ_CONCURRENCY=16
EVPOLY_ORDER_SUBMIT_CONCURRENCY=16
EVPOLY_ORDER_SUBMIT_VERBOSE_LOGS=false
EVPOLY_TRADE_SUMMARY_MAX_PENDING_ROWS=25

# Optional MM 2.0 strategy (top-of-book two-outcome BUY quoting on reward markets)
EVPOLY_MM_SPORT_HARD_DISABLE=false
EVPOLY_MM_SPORT_EVENT_DRIVEN_ENABLE=true
EVPOLY_MM_SPORT_EVENT_MIN_SCAN_MS=1000
EVPOLY_MM_SPORT_WS_STALE_MS=600
EVPOLY_MM_SPORT_FIFO_WS_GAP_CANCEL_MS=5000
EVPOLY_MM_SPORT_MIN_REWARD_RATE_PER_DAY=5
EVPOLY_MM_SPORT_DISCOVERY_ROUTE=sports
EVPOLY_MM_SPORT_QUOTE_SIZE_MODE=depth_ratio
EVPOLY_MM_SPORT_ENTRY_PRICE_MODE=best_bid
EVPOLY_MM_SPORT_QUOTE_SIZE_MULT=1.2
EVPOLY_MM_SPORT_NONSPORT_QUOTE_SIZE_MODE=
EVPOLY_MM_SPORT_NONSPORT_QUOTE_SIZE_MULT=
EVPOLY_MM_SPORT_POST_ONLY=true
EVPOLY_MM_SPORT_ORDER_SUBMIT_TIMEOUT_MS=10000
EVPOLY_MM_SPORT_MAX_SHARE_RATIO=0.20
EVPOLY_MM_SPORT_MAX_QUOTE_SHARES=1000
EVPOLY_MM_SPORT_MIN_TOP_DEPTH_USD=1100
EVPOLY_MM_SPORT_NONSPORT_MAX_SHARE_RATIO=0.20
EVPOLY_MM_SPORT_NONSPORT_MAX_QUOTE_SHARES=200
EVPOLY_MM_SPORT_NONSPORT_MIN_TOP_DEPTH_USD=
EVPOLY_MM_SPORT_FIFO_MAX_SHARE_RATIO=0.50
EVPOLY_MM_SPORT_ACTIVE_NONSPORT_MARKET_CAP=
EVPOLY_MM_SPORT_MIN_ENTRY_TOP_BID_PRICE=0.05
EVPOLY_MM_SPORT_ALLOWED_SPORT_LEAGUE_CODES=
EVPOLY_MM_SPORT_BLOCKED_SPORT_LEAGUE_CODES=
EVPOLY_MM_SPORT_BLOCKED_COMPETITION_LEVELS=
EVPOLY_MM_SPORT_MARKET_ALLOWLIST_KEYWORDS=
EVPOLY_MM_SPORT_MARKET_BLACKLIST_KEYWORDS=
EVPOLY_MM_SPORT_REWARD_MIN_SHARES_CAP=0
EVPOLY_MM_SPORT_REQUIRE_REWARD_ELIGIBLE=true
EVPOLY_MM_SPORT_ALLOW_SPONSORED_REWARDS=true
EVPOLY_MM_SPORT_SPONSORED_REWARD_MIN_SHARE=0.50
EVPOLY_MM_SPORT_MATCH_ONLY=true
EVPOLY_MM_SPORT_POLYMARKET_LIVE_GUARD_ENABLE=true
EVPOLY_MM_SPORT_POLYMARKET_LIVE_GUARD_WS_ENABLE=true
EVPOLY_MM_SPORT_POLYMARKET_LIVE_GUARD_WS_STALE_MS=600000
EVPOLY_MM_SPORT_POLYMARKET_SPORTS_WS_URL=wss://sports-api.polymarket.com/ws
EVPOLY_MM_SPORT_INVENTORY_EXIT_START_SEC=3600
EVPOLY_MM_SPORT_NONSPORT_END_EXIT_START_SEC=172800
EVPOLY_MM_SPORT_NONSPORT_ENTRY_SCHEDULE_ENABLE=false
EVPOLY_MM_SPORT_NONSPORT_ENTRY_SCHEDULE_DAYS_UTC=mon,tue,wed,thu,fri
EVPOLY_MM_SPORT_NONSPORT_ENTRY_SCHEDULE_START_MINUTE_UTC=780
EVPOLY_MM_SPORT_NONSPORT_ENTRY_SCHEDULE_END_MINUTE_UTC=240
EVPOLY_MM_SPORT_INVENTORY_EXIT_MAX_LOSS_CENTS=10
EVPOLY_MM_SPORT_PAUSE_AFTER_FILL_SEC=3600
EVPOLY_MM_SPORT_BUST_WINDOW_MS=1000
EVPOLY_MM_SPORT_BUST_SHARES_1S=10000
EVPOLY_MM_SPORT_BUST_PAUSE_MIN_SEC=60
EVPOLY_MM_SPORT_BUST_PAUSE_MAX_SEC=300
EVPOLY_MM_SPORT_RATIO_BREACH_CANCEL_COOLDOWN_MS=200
EVPOLY_MM_SPORT_REPRICE_MIN_INTERVAL_MS=600
EVPOLY_MM_SPORT_QUOTE_EXPIRY_MIN_SEC=65
EVPOLY_MM_SPORT_QUOTE_EXPIRY_MAX_SEC=185
EVPOLY_MM_SPORT_QUOTE_COOLDOWN_MIN_SEC=10
EVPOLY_MM_SPORT_QUOTE_COOLDOWN_MAX_SEC=60
EVPOLY_MM_SPORT_QUOTE_HOLD_MIN_SEC=20
EVPOLY_MM_SPORT_QUOTE_HOLD_MAX_SEC=45
EVPOLY_MM_SPORT_SIZE_REQUOTE_DELTA_PCT=0.20
EVPOLY_MM_SPORT_VERBOSE_BUDGET_EVENTS=false
EVPOLY_MM_SPORT_MAX_MARKETS=0
# Unified strategy base sizing (blank => 10 USD except Endgame => 50 USD)
EVPOLY_WEEKEND_POLICY=off
EVPOLY_PREMARKET_BASE_SIZE_USD=
EVPOLY_PREMARKET_TIMEFRAMES=5m,15m,1h,4h
EVPOLY_PREMARKET_TP_ENABLE=true
EVPOLY_ENDGAME_BASE_SIZE_USD=
EVPOLY_ENDGAME_EXECUTION_SIZE_MODE=shares
EVPOLY_ENDGAME_BASE_SIZE_SHARES=
EVPOLY_EVCURVE_BASE_SIZE_USD=
EVPOLY_EVCURVE_FILL_FALLBACK_POLL_MS=1500
EVPOLY_SESSIONBAND_BASE_SIZE_USD=
EVPOLY_SESSIONBAND_EXECUTION_SIZE_MODE=usd
EVPOLY_SESSIONBAND_BASE_SIZE_SHARES=10
EVPOLY_EVSNIPE_SIZE_USD=
EVPOLY_EVSNIPE_STRATEGY_CAP_USD=
EVPOLY_EVSNIPE_PRICE_CACHE_ENABLE=false
EVPOLY_EVSNIPE_REQUIRE_PREWARMED_METADATA=false
EVPOLY_EVSNIPE_TRIGGER_MAX_AGE_MS=250
EVPOLY_EVSNIPE_TICK_DROP_IF_FULL=true
EVPOLY_EVSNIPE_SELECTED_TOKEN_PREWARM_MAX_TOKENS_PER_REFRESH=64
EVPOLY_EVSNIPE_SELECTED_TOKEN_PREWARM_COOLDOWN_MS=180000
EVPOLY_EVSNIPE_BYPASS_GENERIC_WORKER_CAPS=true
EVPOLY_EVSNIPE_BYPASS_SUBMIT_SEMAPHORE=true
EVPOLY_ENTRY_DEDUPE_COOLDOWN_EVSNIPE_MS=100

# Retention (keeps runtime artifacts bounded; set cron via scripts/install_evpoly_retention_cron.sh)
EVPOLY_EVENTS_ROTATE_KEEP=3
EVPOLY_HISTORY_ROTATE_KEEP=3
EVPOLY_DB_BACKUP_RETENTION_DAYS=3
EVPOLY_HISTORY_DIR_RETENTION_DAYS=3
EVPOLY_RETENTION_CRON_EXPR='17 * * * *'
EVPOLY_PENDING_ORDER_PRUNE_ENABLE=true
EVPOLY_PENDING_ORDER_PRUNE_TTL_MINUTES=60
EVPOLY_PENDING_ORDER_PRUNE_INTERVAL_SEC=300
EVPOLY_PENDING_ORDER_PRUNE_BATCH_SIZE=50000
EVPOLY_PENDING_ORDER_PRUNE_STARTUP_MAX_ROWS=500000
EVPOLY_PENDING_ORDER_PRUNE_RUNTIME_MAX_ROWS=50000
EVPOLY_PENDING_ORDER_PRUNE_GUARD_ENABLE=true
EVPOLY_DB_MAINTENANCE_ENABLE=true
EVPOLY_DB_MAINTENANCE_INTERVAL_SEC=900
EVPOLY_DB_MAINTENANCE_STARTUP_GRACE_SEC=180
EVPOLY_DB_MAINTENANCE_IDLE_P95_WAIT_MS=25
EVPOLY_DB_MAINTENANCE_IDLE_MIN_SAMPLES=0
EVPOLY_DB_MAINTENANCE_HOT_WINDOW_GUARD_MS=10000
EVPOLY_DB_BACKGROUND_JITTER_MAX_MS=30000
EVPOLY_DB_MAINTENANCE_MAX_RUNTIME_MS=3000
EVPOLY_DB_MAINTENANCE_BUSY_TIMEOUT_MS=100
EVPOLY_DB_MAINTENANCE_OPTIMIZE_ENABLE=true
EVPOLY_DB_MAINTENANCE_CHECKPOINT_ENABLE=false
EVPOLY_DB_MAINTENANCE_CHECKPOINT_TRUNCATE_ENABLE=false
EVPOLY_DB_MAINTENANCE_WAL_TRUNCATE_MIN_BYTES=67108864
EVPOLY_DB_MAINTENANCE_WAL_TRUNCATE_IDLE_P95_WAIT_MS=10
EVPOLY_DB_LATENCY_CRITICAL_STRATEGIES=endgame_sweep_v1,sessionband_v1,evsnipe_v1
EVPOLY_DB_LATENCY_CRITICAL_TIMEFRAMES=5m,15m,1h,4h,1d
EVPOLY_DB_FEATURE_SNAPSHOT_QUEUE_ENABLE=true
EVPOLY_DB_FEATURE_SNAPSHOT_QUEUE_CAPACITY=10000
EVPOLY_DB_FEATURE_SNAPSHOT_QUEUE_RETRY_MS=500

# Startup controls
# Set to false to skip startup pending-order reconcile pass (faster boot).
EVPOLY_STARTUP_PENDING_RECONCILE_ENABLE=true
# to preserve weak-exit SELL continuity across restarts.
EVPOLY_STARTUP_CANCEL_ALL_ORDERS=true
