{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EVPoly",
  "version": "2.1.1",
  "identifier": "com.evpoly.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run desktop:dev",
    "beforeBuildCommand": "npm run desktop:build"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "EVPoly",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://polymarket-upload.s3.us-east-2.amazonaws.com https://polymarket.com https://*.polymarket.com https://*.magic.link; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://ipc.localhost https://api.github.com https://github.com https://objects.githubusercontent.com https://github-releases.githubusercontent.com https://release-assets.githubusercontent.com https://*.githubusercontent.com https://data-api.polymarket.com https://*.magic.link; frame-src 'self' https://*.magic.link;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "publisher": "Degenapetrader",
    "homepage": "https://www.evplus.ai/",
    "shortDescription": "Desktop manager for the EVPoly trading bot.",
    "longDescription": "EVPoly Desktop bundles the EVPoly trading bot sidecar and provides a simple onboarding, launch, and monitoring flow for Windows and Ubuntu XFCE users.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/evpoly-bot"
    ],
    "linux": {
      "deb": {
        "depends": [
          "xrdp",
          "xorgxrdp"
        ],
        "preInstallScript": "./linux/preinst.sh",
        "postInstallScript": "./linux/postinst.sh",
        "postRemoveScript": "./linux/postrm.sh",
        "files": {
          "/usr/share/doc/evpoly/linux-install.md": "../docs/linux-install.md"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEREEyMDUzNTkyQzAxMTcKUldRWEFTeFpVeURhamVrSWVIblFOcGNXR3JkaitqenV4Z09wWFNDMUYvcUFhcWlnQ2FCNndJcmYK",
      "endpoints": [
        "https://github.com/Degenapetrader/EVPOLY/releases/download/Linux-latest/latest.json"
      ]
    }
  }
}
